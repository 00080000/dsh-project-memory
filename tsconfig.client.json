{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "src/client",
    "outDir": "lib/types/client",
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "moduleResolution": "bundler",
    "types": ["react", "react-dom"],
    "noEmit": true
  },
  "include": ["src/client/**/*"],
  "exclude": ["node_modules", "lib", "test"]
}